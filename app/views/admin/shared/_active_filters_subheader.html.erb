<div id="active_filters_subheader">
<%
  time_period = params[:time_period].presence || "past_month"
  time_label = case time_period
               when "past_day"   then "Past day"
               when "past_week"  then "Past week"
               when "past_month" then "Past month"
               when "past_year"  then "Past year"
               end

  audience_labels_map = {
    "visitors" => "Visitors",
    "users"    => "Users",
    "staff"    => "Admins"
  }

  default_audiences = %w[visitors users]
  audience_values = Array(params[:audience]).reject(&:blank?).presence || default_audiences
  audience_labels = audience_values.filter_map { |v| [v, audience_labels_map[v]] }.select(&:last)

  has_search_filters = params[:name].present? || params[:resource_name].present? ||
                       params[:visit_id].present? || params[:props].present? ||
                       params[:user_id].present? || params[:from].present? ||
                       params[:to].present?
%>
<% if time_label || audience_labels.any? || has_search_filters %>
  <div class="flex flex-wrap items-center gap-2 mb-4 text-sm" data-controller="filter-chip">
    <span class="text-gray-500">Filters applied:</span>
    <% audience_labels.each do |value, label| %>
      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-pink-100 text-pink-800 font-medium">
        <%= label %>
        <button type="button" data-action="filter-chip#remove" data-param="audience" data-value="<%= value %>"
                class="ml-0.5 text-pink-600 hover:text-pink-900">&times;</button>
      </span>
    <% end %>
    <% if time_label %>
      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-indigo-100 text-indigo-800 font-medium">
        <%= time_label %>
        <button type="button" data-action="filter-chip#remove" data-param="time_period"
                class="ml-0.5 text-indigo-600 hover:text-indigo-900">&times;</button>
      </span>
    <% end %>
    <% if params[:from].present? %>
      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-indigo-100 text-indigo-800 font-medium">
        From: <%= params[:from] %>
        <button type="button" data-action="filter-chip#remove" data-param="from"
                class="ml-0.5 text-indigo-600 hover:text-indigo-900">&times;</button>
      </span>
    <% end %>
    <% if params[:to].present? %>
      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-indigo-100 text-indigo-800 font-medium">
        To: <%= params[:to] %>
        <button type="button" data-action="filter-chip#remove" data-param="to"
                class="ml-0.5 text-indigo-600 hover:text-indigo-900">&times;</button>
      </span>
    <% end %>
    <% if params[:name].present? %>
      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-blue-100 text-blue-800 font-medium">
        Event: <%= params[:name] %>
        <button type="button" data-action="filter-chip#remove" data-param="name"
                class="ml-0.5 text-blue-600 hover:text-blue-900">&times;</button>
      </span>
    <% end %>
    <% if params[:resource_name].present? %>
      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-green-100 text-green-800 font-medium">
        Resource: <%= params[:resource_name] %>
        <button type="button" data-action="filter-chip#remove" data-param="resource_name"
                class="ml-0.5 text-green-600 hover:text-green-900">&times;</button>
      </span>
    <% end %>
    <% if params[:visit_id].present? %>
      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-yellow-100 text-yellow-800 font-medium">
        Visit: <%= params[:visit_id] %>
        <button type="button" data-action="filter-chip#remove" data-param="visit_id"
                class="ml-0.5 text-yellow-600 hover:text-yellow-900">&times;</button>
      </span>
    <% end %>
    <% if params[:props].present? %>
      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-purple-100 text-purple-800 font-medium">
        Props: <%= params[:props] %>
        <button type="button" data-action="filter-chip#remove" data-param="props"
                class="ml-0.5 text-purple-600 hover:text-purple-900">&times;</button>
      </span>
    <% end %>
    <% if params[:user_id].present? %>
      <% user = User.find_by(id: params[:user_id]) %>
      <% if user %>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-orange-100 text-orange-800 font-medium">
          User: <%= user.full_name %>
          <button type="button" data-action="filter-chip#remove" data-param="user_id"
                  class="ml-0.5 text-orange-600 hover:text-orange-900">&times;</button>
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>
</div>
